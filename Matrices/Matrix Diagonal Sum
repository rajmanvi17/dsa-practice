var diagonalSum = function(mat) {
    let n = mat.length;
    let sum = 0;

    for (let i = 0; i < n; i++) {
        sum += mat[i][i];                 // primary
        sum += mat[i][n - 1 - i];         // secondary
    }

    // remove double counted center (if n is odd)
    if (n % 2 === 1) {
        let mid = Math.floor(n / 2);
        sum -= mat[mid][mid];
    }

    return sum;
};
