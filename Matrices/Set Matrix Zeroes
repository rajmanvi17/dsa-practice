var setZeroes = function(matrix) {
    let rows = matrix.length;
    let cols = matrix[0].length;

    let firstRowZero = false;
    let firstColZero = false;

    // check first row
    for (let j = 0; j < cols; j++) {
        if (matrix[0][j] === 0) {
            firstRowZero = true;
            break;
        }
    }

    // check first column
    for (let i = 0; i < rows; i++) {
        if (matrix[i][0] === 0) {
            firstColZero = true;
            break;
        }
    }

    // mark rows & cols
    for (let i = 1; i < rows; i++) {
        for (let j = 1; j < cols; j++) {
            if (matrix[i][j] === 0) {
                matrix[i][0] = 0;
                matrix[0][j] = 0;
            }
        }
    }

    // update cells
    for (let i = 1; i < rows; i++) {
        for (let j = 1; j < cols; j++) {
            if (
                matrix[i][0] === 0 ||
                matrix[0][j] === 0
            ) {
                matrix[i][j] = 0;
            }
        }
    }

    // update first row
    if (firstRowZero) {
        for (let j = 0; j < cols; j++) {
            matrix[0][j] = 0;
        }
    }

    // update first col
    if (firstColZero) {
        for (let i = 0; i < rows; i++) {
            matrix[i][0] = 0;
        }
    }
};
