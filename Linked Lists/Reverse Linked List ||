Pattern- Linked List + Pointer Manipulation

Code-

var reverseBetween = function(head, left, right) {

    if (!head || left === right) {
        return head;
    }

    let dummy = new ListNode(0);
    dummy.next = head;

    let prev = dummy;

    // Step 1: move prev before left
    for (let i = 1; i < left; i++) {
        prev = prev.next;
    }

    let curr = prev.next;

    // Step 2: reverse
    for (let i = 0; i < right - left; i++) {

        let next = curr.next;

        curr.next = next.next;
        next.next = prev.next;
        prev.next = next;
    }

    return dummy.next;
};
