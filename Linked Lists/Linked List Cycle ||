var detectCycle = function(head) {
    let slow = head;
    let fast = head;

    // Find meeting point
    while (fast && fast.next) {
        slow = slow.next;
        fast = fast.next.next;

        if (slow === fast) {

            let ptr = head;

            while (ptr !== slow) {
                ptr = ptr.next;
                slow = slow.next;
            }

            return ptr;
        }
    }

    return null;
};
