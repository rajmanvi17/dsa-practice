function maxProduct(nums) {
    let maxProd = nums[0];
    let curMax = nums[0];
    let curMin = nums[0];

    for (let i = 1; i < nums.length; i++) {
        const num = nums[i];

        if (num < 0) {
            [curMax, curMin] = [curMin, curMax]; // swap, since sign flip
        }

        curMax = Math.max(num, curMax * num);
        curMin = Math.min(num, curMin * num);

        maxProd = Math.max(maxProd, curMax);
    }

    return maxProd;
}
