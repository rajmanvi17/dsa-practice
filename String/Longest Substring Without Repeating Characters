function lengthOfLongestSubstring(s) {
    const lastSeen = new Map();
    let start = 0;
    let maxLen = 0;

    for (let end = 0; end < s.length; end++) {
        const ch = s[end];
        if (lastSeen.has(ch) && lastSeen.get(ch) >= start) {
            start = lastSeen.get(ch) + 1;
        }
        lastSeen.set(ch, end);
        maxLen = Math.max(maxLen, end - start + 1);
    }

    return maxLen;
}
